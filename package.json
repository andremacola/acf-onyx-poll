{
	"name": "acf-onyx-poll",
	"version": "2.0.0",
	"description": "Independent WordPress polls with native administration and dedicated database tables",
	"main": "./assets/js/app.js",
	"repository": "git@github.com:andremacola/onyx-poll.git",
	"author": "Andre Macola <andremacola@gmail.com>",
	"license": "MIT",
	"devDependencies": {
		"@wordpress/eslint-plugin": "^4.1.0",
		"eslint": "^6.8.0",
		"clean-css": "^5.3.3",
		"terser": "^5.44.0"
	},
	"scripts": {
		"build": "npm run build:css && npm run build:js",
		"build:css": "node scripts/build-css.cjs",
		"build:js": "terser assets/js/app.js --compress --mangle --output assets/js/onyx-poll.min.js",
		"release": "npm run build && node scripts/prepare-release.cjs",
		"release:version": "node scripts/set-version.cjs",
		"release:zip": "npm run build && node scripts/prepare-release.cjs --zip-only",
		"test:release": "node tests/release.cjs"
	}
}
